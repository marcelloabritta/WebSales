@model IEnumerable<SalesWeb.Models.SalesRecord>

@{
    ViewData["Title"] = "Simple Search";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<!-- Barra de Filtro com Card/Form -->
<div class="card bg-body-tertiary mb-4 p-3 shadow-sm">
    <form class="row g-3 align-items-end" role="search">
        <div class="col-md-4">
            <label for="minDate" class="form-label fw-semibold">Min Date</label>
            <input type="date" class="form-control" name="minDate" value="@ViewData["minDate"]" />
        </div>
        <div class="col-md-4">
            <label for="maxDate" class="form-label fw-semibold">Max Date</label>
            <input type="date" class="form-control" name="maxDate" value="@ViewData["maxDate"]" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Painel de Resultados (Card) -->
<div class="card border-primary mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title h5 mb-0">Total sales = @Model.Sum(obj => obj.Amount).ToString("F2")</h3>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Id)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Date)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Seller)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Seller.Department)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Amount)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Status)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Seller.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Seller.Department.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Amount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>