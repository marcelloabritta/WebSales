@model IEnumerable<SalesWeb.Models.SalesRecord>

@{
    ViewData["Title"] = "Sales Records";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row g-4">
    <!-- Simple Search -->
    <div class="col-md-6">
        <div class="card p-3 shadow-sm">
            <form asp-action="SimpleSearch">
                <fieldset>
                    <legend class="fw-bold mb-3">Simple search</legend>
                    
                    <div class="row mb-3 align-items-center">
                        <label for="minDate" class="col-lg-3 col-form-label">Min Date</label>
                        <div class="col-lg-9">
                            <input type="date" name="minDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <label for="maxDate" class="col-lg-3 col-form-label">Max Date</label>
                        <div class="col-lg-9">
                            <input type="date" name="maxDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-lg-9 offset-lg-3">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>

    <!-- Grouping Search -->
    <div class="col-md-6">
        <div class="card p-3 shadow-sm">
            <form asp-action="GroupingSearch">
                <fieldset>
                    <legend class="fw-bold mb-3">Grouping search</legend>
                    
                    <div class="row mb-3 align-items-center">
                        <label for="minDate" class="col-lg-3 col-form-label">Min Date</label>
                        <div class="col-lg-9">
                            <input type="date" name="minDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <label for="maxDate" class="col-lg-3 col-form-label">Max Date</label>
                        <div class="col-lg-9">
                            <input type="date" name="maxDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-lg-9 offset-lg-3">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>